# ============================================================================
# Sentinel ATLAS — Environment Configuration
# ============================================================================

# Network and Service Binding
PORT=8000
GATEWAY_URL=http://127.0.0.1:8000

# Section 21: Fail-Safe Mode (FAIL_OPEN or FAIL_CLOSED)
# Development default: FAIL_OPEN (logs SECURITY_GATEWAY_UNAVAILABLE on unexpected errors)
GATEWAY_FAIL_SAFE=FAIL_OPEN

# Local Ollama LLM Service URL
OLLAMA_URL=http://127.0.0.1:11434

# Section 27: Security, Privacy & Log Retention Policy
LOG_RETENTION_DAYS=30
STORE_RAW_PROMPTS=true
STORE_EMBEDDINGS=true

# Section 19: Risk Factor Scoring Defaults (Points out of 100)
RISK_W1_ATLAS=25.0
RISK_W2_DRIFT=20.0
RISK_W3_SENSITIVITY=20.0
RISK_W4_PERSISTENCE=15.0
RISK_W5_MISALIGNMENT=20.0
RISK_W6_BEHAVIORAL=10.0
RISK_W7_BENIGN_DISCOUNT=15.0
